{
  "language": "ja",
  "base_branch": "main",
  "require_status_checks": true,
  "allow_ai_merge": false,
  "project": {
    "owner": null,
    "number": null
  },
  "status": {
    "todo": "Todo",
    "start": "In Progress",
    "pr_opened": null,
    "done": "Done"
  },
  "story_point": {
    "field": "Story Point"
  },
  "review": {
    "max_rounds": 3,
    "model": null
  },
  "sub_issues": {
    "max_depth": 3
  },
  "labels": {
    "types": ["feat", "fix", "refactor", "perf", "test", "docs", "build", "ci", "chore"]
  },
  "branch": {
    "pattern": "{type}/{issue_number}-{slug}",
    "worktree_dir": ".claude/worktrees"
  },
  "commit": {
    "types": ["feat", "fix", "refactor", "perf", "test", "docs", "build", "ci", "chore", "style", "revert"],
    "pattern": "^(feat|fix|refactor|perf|test|docs|build|ci|chore|style|revert)(\\([a-z0-9-]+\\))?!?: .+",
    "scope_required": false
  },
  "adr": {
    "dir": "docs/adr"
  },
  "pr": {
    "title_pattern": "^(feat|fix|refactor|perf|test|docs|build|ci|chore|style|revert)(\\([a-z0-9-]+\\))?!?: .+",
    "draft": false,
    "close_keyword": "Closes",
    "template": null
  },
  "pr_respond": {
    "handlers": {}
  }
}
