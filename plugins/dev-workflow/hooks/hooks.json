{
  "description": "base_branch（既定は main）を守る。main の上での commit、main への push、強制 push を止める。規約（branch.pattern）に合わない名前でブランチを作るときは、止めずに警告する。セッションの始まり（起動・/resume・/clear・コンパクト）に、タスクの進め方を Claude に渡す",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/hooks/guard-git.sh\""
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/hooks/task-flow.sh\""
          }
        ]
      }
    ]
  }
}
